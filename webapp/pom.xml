<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.trino.gateway</groupId>
        <artifactId>trino-gateway-parent</artifactId>
        <version>23-SNAPSHOT</version>
        <relativePath>../</relativePath>
    </parent>

    <artifactId>webapp</artifactId>
    <packaging>jar</packaging>
    <name>webapp</name>
    <description>Web UI of Trino Gateway</description>

    <properties>
        <!-- The web UI sources carry no license headers -->
        <air.check.skip-license>true</air.check.skip-license>
        <!-- The sources JAR is built by the maven-jar-plugin from the web UI sources -->
        <maven.source.skip>true</maven.source.skip>
    </properties>

    <build>
        <plugins>
            <!-- Maven Central requires a javadoc JAR, and this module has no Java code.
                 Attach a placeholder with the README, as Maven Central suggests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <!-- The maven-source-plugin only knows Java source roots and resources,
                         and would package the built bundle instead of the sources. -->
                    <execution>
                        <id>web-ui-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <classifier>sources</classifier>
                            <classesDirectory>${project.basedir}</classesDirectory>
                            <includes>
                                <include>src/**</include>
                                <include>public/**</include>
                                <include>e2e/**</include>
                                <include>scripts/**</include>
                                <include>*.html</include>
                                <include>*.json</include>
                                <include>*.js</include>
                                <include>*.ts</include>
                                <include>*.yaml</include>
                                <include>README.md</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>placeholder-javadoc</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <classifier>javadoc</classifier>
                            <classesDirectory>${project.basedir}</classesDirectory>
                            <includes>
                                <include>README.md</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- There are no Java tests in this module -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <!-- Node.js and pnpm are installed into target/node -->
                    <installDirectory>${project.build.directory}</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install node and pnpm</id>
                        <goals>
                            <goal>install-node-and-pnpm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <nodeVersion>v24.21.0</nodeVersion>
                            <pnpmVersion>11.28.5</pnpmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>install --ignore-scripts</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>run check</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
